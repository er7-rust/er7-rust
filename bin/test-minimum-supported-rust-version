#!/usr/bin/env bash
# Check and test on the minimum supported Rust version (N-2) and on N-1.
# Read the same manifest as CI. N-1 is the next minor.
set -euo pipefail

cd "$(dirname "$0")/.."

msrv=$(sed -nE 's/^rust-version[[:space:]]*=[[:space:]]*"([0-9]+\.[0-9]+)"$/\1/p' er7/Cargo.toml)
if [ -z "$msrv" ]; then
  echo "error: expected a major.minor rust-version in er7/Cargo.toml" >&2
  exit 1
fi
major=${msrv%%.*}
minor=${msrv##*.}
n_minus_1="$major.$((minor + 1))"

host=$(rustc -vV | sed -n 's/^host: //p')
installed=$(rustup toolchain list)
for minor_version in "$msrv" "$n_minus_1"; do
  # rustup distinguishes a minor alias from an explicitly installed patch.
  tc=""
  while read -r name _; do
    version=${name%-"$host"}
    if [[ "$version" != "$name" && ( "$version" == "$minor_version" || "${version%.*}" == "$minor_version" ) ]]; then
      # rustup can retain an entry for an interrupted installation. Do not
      # let a broken minor alias hide a healthy installed patch release.
      if rustc +"$name" -vV >/dev/null 2>&1; then
        tc=$name
        break
      fi
    fi
  done <<< "$installed"
  if [ -z "$tc" ]; then
    echo "error: run rustup toolchain install $minor_version for $host" >&2
    exit 1
  fi
  echo "==> $tc"
  cargo +"$tc" check --locked --all-targets --workspace
  cargo +"$tc" test --locked --workspace
  cargo +"$tc" check --locked --all-targets --manifest-path er7/fuzz/Cargo.toml
done
echo "OK: MSRV $msrv and N-1 $n_minus_1 pass"
