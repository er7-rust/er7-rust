#!/bin/sh
# Require every executable line in the three published crates' source trees
# to run in at least one test target. cargo-llvm-cov's summary adds duplicate
# monomorphizations from every integration/example binary; LCOV instead gives
# one merged DA record per source line, which is the stable quantity this gate
# intentionally checks.

set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
tmp_report=$(mktemp "${TMPDIR:-/tmp}/er7-coverage.XXXXXX")
trap 'rm -f "$tmp_report"' EXIT HUP INT TERM
report=$tmp_report

# `bin/test-coverage --check FILE.lcov` skips the build and only checks an
# existing LCOV report; bin/test-coverage-selftest uses it.
if [ "${1:-}" = "--check" ]; then
    report=${2:?usage: bin/test-coverage --check FILE.lcov}
else
    cd "$root"
    cargo llvm-cov \
        --workspace \
        --exclude er7-bench \
        --exclude er7-redact-bench \
        --all-targets \
        --lcov \
        --output-path "$report"
fi

awk '
function crate_of(path) {
    if (path ~ /\/er7-redact\/src\//) return "er7-redact"
    if (path ~ /\/serde-er7\/src\//) return "serde-er7"
    if (path ~ /\/er7\/src\//) return "er7"
    return ""
}

/^SF:/ {
    source = substr($0, 4)
    crate = crate_of(source)
    next
}

/^DA:/ && crate != "" {
    split(substr($0, 4), fields, ",")
    total[crate]++
    if (fields[2] > 0) {
        covered[crate]++
    } else {
        missed[crate]++
        print source ":" fields[1] ": uncovered executable line" > "/dev/stderr"
    }
}

END {
    n = split("er7 er7-redact serde-er7", crates, " ")
    bad = 0
    for (i = 1; i <= n; i++) {
        c = crates[i]
        if (total[c] == 0) {
            print "coverage report contained no source lines for " c > "/dev/stderr"
            bad = 1
        } else {
            printf "%s line coverage: %d/%d\n", c, covered[c], total[c]
            if (missed[c] > 0) bad = 1
            all += total[c]; allcov += covered[c]
        }
    }
    if (all > 0) {
        printf "published source line coverage: %d/%d (%.2f%%)\n", \
            allcov, all, 100 * allcov / all
    }
    exit bad
}
' "$report"
